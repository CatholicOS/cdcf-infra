# env files — ignore everything except .example templates
.env
.env.*
!.env.*.example

# editor/OS junk
.DS_Store
*.swp
.vscode/
.idea/

# secrets accidentally produced by setup scripts
*.pat
*.key

# python (for any future scripts)
.venv/
__pycache__/
*.pyc

# Serena MCP per-developer IDE state — not shared, not infrastructure
.serena/

# agent scratch: worktrees and subagent-driven-development ledgers.
# Only .claude/worktrees/ — the rest of .claude/ (settings, commands, agents)
# is conventionally shared project config and stays tracked.
.claude/worktrees/
.superpowers/
