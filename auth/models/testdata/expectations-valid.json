    "wider_region",
    "national_calendar",
    "diocesan_calendar",
    "rite_calendar",
    "national_calendar_test",
    "diocesan_calendar_test",
    "rite_calendar_test"
  ],
  "required_relations": {
    "wider_region": [
      "admin",
      "editor",
      "viewer",
      "member_nation"
    ],
    "national_calendar": [
      "admin",
      "editor",
      "viewer"
    ],
    "diocesan_calendar": [
      "admin",
      "editor",
      "viewer"
    ],
    "rite_calendar": [
      "admin",
      "editor",
      "viewer"
    ],
    "national_calendar_test": [
      "admin",
      "editor",
      "viewer"
    ],
    "diocesan_calendar_test": [
      "admin",
      "editor",
      "viewer"
    ],
    "rite_calendar_test": [
      "admin",
      "editor",
      "viewer"
    ]
  },
  "forbidden_types": [
    "general_roman_calendar",
    "general_roman_calendar_test",
    "test_definition"
  ],
  "forbidden_relations": {
