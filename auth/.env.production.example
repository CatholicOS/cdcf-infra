# cdcf-infra/auth — production env template
#
# Copy to .env.production on the VPS only (path:
# /opt/cdcf-auth/auth/.env.production). NEVER commit values.
# The chrooted deploy user is the only account that should read this
# file (mode 0600).

# ─── Host Postgres connection (shared with other VPS services) ───────
#
# Zitadel and OpenFGA both connect to the host's native PostgreSQL via
# the docker-bridge host-gateway. Roles + databases must exist on the
# host BEFORE bringing up the stack — see README.md "Prerequisites" for
# the exact SQL.

ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=

OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga
OPENFGA_DB_PASSWORD=

# ─── Zitadel ──────────────────────────────────────────────────────────

# Zitadel masterkey — exactly 32 chars. Generate once, NEVER rotate.
# (Loss of the masterkey makes the Postgres dump unrecoverable.)
#   openssl rand -base64 32 | head -c 32
ZITADEL_MASTERKEY=

# Bootstrap admin user (IAM-OWNER) created on first boot.
# Login name is ZITADEL_ADMIN_EMAIL (we use email-as-username; see compose).
# Forced password change on first login (set via
# ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED=true in compose).
#
# IMPORTANT: password must satisfy Zitadel's *default* password complexity
# policy, evaluated during the 03_default_instance migration that creates
# this user. Defaults are:
#   - minimum length 8
#   - at least one uppercase letter
#   - at least one lowercase letter
#   - at least one digit
#   - at least one symbol (the one that trips up alphanumeric-only generators)
# Safe generator that guarantees all four classes:
#   echo "$(openssl rand -base64 64 | tr -d '/+=' | head -c 16)Aa1!"
ZITADEL_ADMIN_USER=zitadel-admin
ZITADEL_ADMIN_PASSWORD=
ZITADEL_ADMIN_EMAIL=
# Optional — used for the IAM admin user's profile display. Defaults to
# "IAM" / "Admin" if unset.
ZITADEL_ADMIN_FIRSTNAME=
ZITADEL_ADMIN_LASTNAME=

# ─── OpenFGA ──────────────────────────────────────────────────────────

# Preshared key for OpenFGA HTTP API authn. Consumers (LitCal, etc.)
# pass this as a Bearer token in the Authorization header. Rotate by
# appending the new key (comma-separated in OPENFGA_AUTHN_PRESHARED_KEYS)
# and removing the old after consumers have migrated.
#   openssl rand -base64 48
OPENFGA_PRESHARED_KEY=

# ─── Off-server backup copy (auth/backup/pg-dump.sh) ──────────────────

# Where the nightly pg_dump output is copied after it is written. Leave
# SFTP_HOST EMPTY to disable the push and keep dumps local only — that is
# the right setting anywhere but production.
#
# This targets the same SFTP host Plesk's own backups use, but with its
# OWN key. Plesk's key lives under /opt/psa/var/modules/sftp-backup/
# ssh-keys/ under a randomly generated filename the extension may
# regenerate on update; borrowing it would make this job fail the day it
# did. Generate a dedicated one and authorize its public half on the
# remote:
#   ssh-keygen -t ed25519 -f /root/.ssh/cdcf-backup -N ''
#
# NOTE: Plesk's backups do NOT cover the auth databases and cannot be made
# to. Plesk backs up what is in its own registry, and every database there
# is MySQL; `zitadel` and `openfga` are host PostgreSQL databases it has
# no knowledge of. This script is the only thing backing them up.
# Further databases on this host to dump through the local `postgres`
# superuser role, space-separated. Their credentials live in other
# services' env files; the local superuser can already read them, so this
# avoids copying a second service's password in here to rotate later.
# Production value:
#   PEER_DBS="litcal_staging litcal_production"
# A name that does not exist is a hard error, checked before anything is
# written, so a typo cannot produce a half-finished run.
PEER_DBS=

# Large peer databases: dumped at a cheaper compression level under
# nice/ionice, and removed locally once the off-server copy is confirmed.
# /var/backups is too small to hold a retention window of multi-GB dumps,
# and `gzip -9` over several GB is heavy enough to disturb the host.
# Production value:
#   LARGE_DBS="bibleget_dev marriage_booklet_production"
LARGE_DBS=
LARGE_GZIP_LEVEL=6

# Host configuration that exists in neither git nor a Plesk-backed vhost.
# Plesk DOES back up the vhost env files (verified against an actual
# archive), so this is only for what it cannot reach.
# Production value:
#   CONFIG_PATHS="/opt/cdcf-auth/auth/.env.production /opt/cdcf-auth/runtime /etc/cron.d/cdcf-auth-backup"
#
# ALWAYS encrypted, and the script refuses to run without a recipient:
# ZITADEL_MASTERKEY is in here, and the zitadel dump it decrypts goes to
# the same remote. Generate the key OFF this machine and keep the private
# half offline — only the public half belongs here:
#   age-keygen -o cdcf-backup.key      # on your own machine
CONFIG_PATHS=
AGE_RECIPIENT=

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=plesk-backup
SFTP_PATH=/uploads/cdcf-auth
SFTP_KEY=/root/.ssh/cdcf-backup
